{
  "name": "@agoraford/ui",
  "version": "0.8.1",
  "description": "Shared design tokens and UI components for the Omega Solution LLC application suite",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "src/tokens"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./tailwind-preset": "./src/tokens/tailwind-preset.js",
    "./tailwind-v4.css": "./src/tokens/tailwind-v4.css"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
